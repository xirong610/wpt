  <property name="styleSheet">
   <string notr="true">QWidget#motor {
    background-color: #F3F4F6;
    font-family: &quot;Segoe UI&quot;, &quot;Microsoft YaHei&quot;, sans-serif;
    color: #1F2937;
}

/* 卡片容器 */
QWidget#widget, QWidget#widget2, QWidget#widget3 {
    background-color: #FFFFFF;
    border: 1px solid #D1D5DB;
    border-radius: 8px;
}

/* 标签通用样式 */
QLabel {
    color: #1F2937;
    font-size: 12px;
    background-color: transparent;
}

/* 输入框通用样式 */
QLineEdit {
    background-color: #FFFFFF;
    border: 1px solid #D1D5DB;
    border-radius: 4px;
    padding: 3px 6px;
    font-size: 12px;
    color: #111827;
}

QLineEdit:focus {
    border: 2px solid #0078D4;
    background-color: #FAFAFA;
}

/* 通用按钮 */
QPushButton {
    background-color: #FFFFFF;
    border: 1px solid #D1D5DB;
    border-radius: 4px;
    padding: 4px 10px;
    font-size: 12px;
    font-weight: 500;
    color: #1F2937;
}

QPushButton:hover {
    background-color: #EFF6FC;
    border-color: #0078D4;
    color: #0078D4;
}

QPushButton:pressed {
    background-color: #DEECF9;
}

/* 所有“确认”按钮统一使用 Fluent 蓝底白字高对比度 */
QPushButton#maxSpeed_X_bt, QPushButton#maxSpeed_Y_bt, QPushButton#maxSpeed_Z_bt,
QPushButton#homeSpeed_bt, QPushButton#homeSpeed_f_bt, QPushButton#home_Pos_bt,
QPushButton#xlength_bt, QPushButton#ylength_bt, QPushButton#zlength_bt,
QPushButton#xpulse_bt, QPushButton#ypulse_bt, QPushButton#zpulse_bt,
QPushButton#xspeed_acc_bt, QPushButton#yspeed_acc_bt, QPushButton#zspeed_acc_bt {
    background-color: #0078D4;
    border: 1px solid #006CBD;
    border-radius: 4px;
    color: #FFFFFF;
    font-weight: bold;
}

QPushButton#maxSpeed_X_bt:hover, QPushButton#maxSpeed_Y_bt:hover, QPushButton#maxSpeed_Z_bt:hover,
QPushButton#homeSpeed_bt:hover, QPushButton#homeSpeed_f_bt:hover, QPushButton#home_Pos_bt:hover,
QPushButton#xlength_bt:hover, QPushButton#ylength_bt:hover, QPushButton#zlength_bt:hover,
QPushButton#xpulse_bt:hover, QPushButton#ypulse_bt:hover, QPushButton#zpulse_bt:hover,
QPushButton#xspeed_acc_bt:hover, QPushButton#yspeed_acc_bt:hover, QPushButton#zspeed_acc_bt:hover {
    background-color: #106EBE;
}

/* 控制按钮专用高对比度 Fluent 样式 */
QPushButton#start_bt {
    background-color: #107C41;
    border: 1px solid #0E703A;
    border-radius: 4px;
    color: #FFFFFF;
    font-weight: bold;
    font-size: 13px;
}
QPushButton#start_bt:hover {
    background-color: #0E703A;
}

QPushButton#stop_bt {
    background-color: #D13438;
    border: 1px solid #B12A2E;
    border-radius: 4px;
    color: #FFFFFF;
    font-weight: bold;
    font-size: 13px;
}
QPushButton#stop_bt:hover {
    background-color: #B12A2E;
}

QPushButton#homebt {
    background-color: #0078D4;
    border: 1px solid #006CBD;
    border-radius: 4px;
    color: #FFFFFF;
    font-weight: bold;
    font-size: 13px;
}
QPushButton#homebt:hover {
    background-color: #106EBE;
}

QPushButton#restartbt {
    background-color: #475569;
    border: 1px solid #334155;
    border-radius: 4px;
    color: #FFFFFF;
    font-weight: bold;
    font-size: 13px;
}
QPushButton#restartbt:hover {
    background-color: #334155;
}

QPushButton#limitbt {
    background-color: #0284C7;
    border: 1px solid #0369A1;
    border-radius: 4px;
    color: #FFFFFF;
    font-weight: bold;
    font-size: 13px;
}
QPushButton#limitbt:hover {
    background-color: #0369A1;
}

QPushButton#unlouckAlarm_bt {
    background-color: #D97706;
    border: 1px solid #B45309;
    border-radius: 4px;
    color: #FFFFFF;
    font-weight: bold;
    font-size: 13px;
}
QPushButton#unlouckAlarm_bt:hover {
    background-color: #B45309;
}

QPushButton#initpos {
    background-color: #6B7280;
    border: 1px solid #4B5563;
    border-radius: 4px;
    color: #FFFFFF;
    font-weight: bold;
    font-size: 13px;
}
QPushButton#initpos:hover {
    background-color: #4B5563;
}

QPushButton#sendbt {
    background-color: #0078D4;
    border: 1px solid #006CBD;
    border-radius: 4px;
    color: #FFFFFF;
    font-weight: bold;
}
QPushButton#sendbt:hover {
    background-color: #106EBE;
}

QPushButton#clearbt {
    background-color: #FFFFFF;
    border: 1px solid #FECACA;
    border-radius: 4px;
    color: #DC2626;
    font-weight: bold;
}
QPushButton#clearbt:hover {
    background-color: #FEF2F2;
    border-color: #F87171;
}

/* 手动方向微调按钮 */
QPushButton#manu_Left_bt, QPushButton#manu_Up_bt, QPushButton#manu_Right_bt, QPushButton#manu_Down_bt,
QPushButton#manu_Front_bt, QPushButton#manu_Back_bt {
    background-color: #FFFFFF;
    border: 1px solid #D1D5DB;
    border-radius: 6px;
}
QPushButton#manu_Left_bt:hover, QPushButton#manu_Up_bt:hover, QPushButton#manu_Right_bt:hover, QPushButton#manu_Down_bt:hover,
QPushButton#manu_Front_bt:hover, QPushButton#manu_Back_bt:hover {
    background-color: #EFF6FC;
    border-color: #0078D4;
}

/* 文本日志与监视器 */
QTextBrowser, QPlainTextEdit {
    background-color: #FFFFFF;
    border: 1px solid #D1D5DB;
    border-radius: 4px;
    color: #111827;
    font-family: Consolas, &quot;Courier New&quot;, monospace;
    font-size: 12px;
}

/* 滑块样式 */
QSlider::groove:horizontal {
    border: 1px solid #D1D5DB;
    height: 6px;
    background: #E5E7EB;
    border-radius: 3px;
}
QSlider::sub-page:horizontal {
    background: #0078D4;
    border-radius: 3px;
}
QSlider::handle:horizontal {
    background: #0078D4;
    border: 2px solid #FFFFFF;
    width: 16px;
    margin-top: -6px;
    margin-bottom: -6px;
    border-radius: 8px;
}
QSlider::handle:horizontal:hover {
    background: #106EBE;
}</string>
