  <property name="styleSheet">
   <string notr="true">/* ========================================================
   Microsoft Fluent Design Style - WPT System 2.0
   ======================================================== */

QMainWindow, QWidget#centralwidget {
    background-color: #F3F4F6;
    font-family: &quot;Segoe UI&quot;, &quot;Microsoft YaHei&quot;, sans-serif;
    color: #1F2937;
}

/* 顶部标题栏卡片 */
QFrame#headerFrame {
    background-color: #FFFFFF;
    border: 1px solid #E5E7EB;
    border-radius: 6px;
    padding: 2px 10px;
    max-height: 48px;
    min-height: 44px;
}

QLabel#appTitle {
    font-size: 16px;
    font-weight: bold;
    color: #0078D4;
}

QLabel#appSubTitle {
    font-size: 11px;
    color: #6B7280;
}

/* Fluent 卡片 */
QGroupBox {
    background-color: #FFFFFF;
    border: 1px solid #E5E7EB;
    border-radius: 8px;
    margin-top: 14px;
    padding: 14px 10px 10px 10px;
    font-size: 12px;
    font-weight: 600;
    color: #111827;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 12px;
    top: 2px;
    padding: 0 6px;
    background-color: #FFFFFF;
    color: #0078D4;
    font-size: 12px;
    font-weight: bold;
}

/* 标签 */
QLabel {
    color: #374151;
    font-size: 12px;
}

/* 输入框与下拉选择框 */
QLineEdit, QComboBox, QPlainTextEdit, QTextBrowser {
    background-color: #FFFFFF;
    border: 1px solid #D1D5DB;
    border-radius: 5px;
    padding: 4px 8px;
    font-size: 12px;
    color: #111827;
    selection-background-color: #0078D4;
    selection-color: #FFFFFF;
}

QLineEdit:hover, QComboBox:hover, QPlainTextEdit:hover, QTextBrowser:hover {
    border-color: #9CA3AF;
}

QLineEdit:focus, QComboBox:focus, QPlainTextEdit:focus {
    border: 2px solid #0078D4;
    padding: 3px 7px;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 22px;
    border-left: none;
}

QComboBox::down-arrow {
    image: none;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 5px solid #6B7280;
    margin-right: 6px;
}

QComboBox QAbstractItemView {
    background-color: #FFFFFF;
    border: 1px solid #E5E7EB;
    border-radius: 6px;
    padding: 4px;
    selection-background-color: #0078D4;
    selection-color: #FFFFFF;
    outline: none;
}

/* 按钮通用风格 (Fluent Button) */
QPushButton {
    background-color: #FFFFFF;
    border: 1px solid #D1D5DB;
    border-radius: 5px;
    padding: 5px 12px;
    font-size: 12px;
    font-weight: 500;
    color: #1F2937;
    min-height: 22px;
}

QPushButton:hover {
    background-color: #F9FAFB;
    border-color: #9CA3AF;
}

QPushButton:pressed {
    background-color: #E5E7EB;
    border-color: #6B7280;
}

QPushButton:disabled {
    background-color: #F3F4F6;
    color: #9CA3AF;
    border-color: #E5E7EB;
}

/* 主操作按钮 (Primary Microsoft Blue) */
QPushButton#getData_Start_bt {
    background-color: #0078D4;
    border: 1px solid #006CBD;
    color: #FFFFFF;
    font-weight: bold;
    font-size: 13px;
    min-height: 28px;
}

QPushButton#getData_Start_bt:hover {
    background-color: #106EBE;
}

QPushButton#getData_Start_bt:pressed {
    background-color: #005A9E;
}

/* 启动电机 (Fluent Green) */
QPushButton#start_bt {
    background-color: #F0FDF4;
    border: 1px solid #86EFAC;
    color: #15803D;
    font-weight: bold;
}

QPushButton#start_bt:hover {
    background-color: #DCFCE7;
    border-color: #4ADE80;
}

QPushButton#start_bt:pressed {
    background-color: #BBF7D0;
}

/* 停止电机 (Fluent Red) */
QPushButton#stop_bt {
    background-color: #FEF2F2;
    border: 1px solid #FECACA;
    color: #B91C1C;
    font-weight: bold;
}

QPushButton#stop_bt:hover {
    background-color: #FEE2E2;
    border-color: #F87171;
}

QPushButton#stop_bt:pressed {
    background-color: #FCA5A5;
}

/* 刷新所有串口按钮 (Fluent Accent Outline) */
QPushButton#refreshPorts_bt {
    background-color: #FFFFFF;
    border: 1px solid #0078D4;
    color: #0078D4;
    font-weight: 600;
    font-size: 13px;
    border-radius: 4px;
    padding: 6px 12px;
}

QPushButton#refreshPorts_bt:hover {
    background-color: #EFF6FC;
    border-color: #005A9E;
    color: #005A9E;
}

QPushButton#refreshPorts_bt:pressed {
    background-color: #DEECF9;
}

QPushButton#initFpgaSignal_bt {
    background-color: #0E7090;
    color: #FFFFFF;
    font-weight: 600;
    border: 1px solid #0891B2;
}

QPushButton#initFpgaSignal_bt:hover {
    background-color: #0891B2;
}

QPushButton#initFpgaSignal_bt:pressed {
    background-color: #155E75;
}

/* 选项卡 (Fluent Tabs) */
QTabWidget::pane {
    border: 1px solid #E5E7EB;
    border-radius: 6px;
    background-color: #FFFFFF;
    top: -1px;
}

QTabBar::tab {
    background-color: #F3F4F6;
    border: 1px solid #E5E7EB;
    border-bottom: none;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    padding: 6px 16px;
    margin-right: 3px;
    font-size: 12px;
    color: #4B5563;
}

QTabBar::tab:selected {
    background-color: #FFFFFF;
    border-bottom: 2px solid #0078D4;
    color: #0078D4;
    font-weight: 600;
}

QTabBar::tab:hover:!selected {
    background-color: #E5E7EB;
}

/* 滚动条 */
QScrollBar:vertical {
    border: none;
    background-color: #F9FAFB;
    width: 6px;
    border-radius: 3px;
}

QScrollBar::handle:vertical {
    background-color: #D1D5DB;
    min-height: 20px;
    border-radius: 3px;
}

QScrollBar::handle:vertical:hover {
    background-color: #9CA3AF;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}
</string>
