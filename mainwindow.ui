  <property name="styleSheet">
   <string notr="true">/* ========================================================
   Microsoft Fluent Design Style - WPT System 2.0
   ======================================================== */

QMainWindow, QWidget#centralwidget {
    background-color: #F3F4F6;
    font-family: &quot;Segoe UI&quot;, &quot;Microsoft YaHei&quot;, sans-serif;
    color: #1F2937;
}

/* 顶部标题栏卡片 */
QFrame#headerFrame {
    background-color: #FFFFFF;
    border: 1px solid #E5E7EB;
    border-radius: 6px;
    padding: 2px 10px;
    max-height: 48px;
    min-height: 44px;
}

QLabel#appTitle {
    font-size: 16px;
    font-weight: bold;
    color: #0078D4;
}

QLabel#appSubTitle {
    font-size: 11px;
    color: #6B7280;
}

/* Fluent 卡片 */
QGroupBox {
    background-color: #FFFFFF;
    border: 1px solid #E5E7EB;
    border-radius: 8px;
    margin-top: 14px;
    padding: 14px 10px 10px 10px;
    font-size: 12px;
    font-weight: 600;
    color: #111827;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 12px;
    top: 2px;
    padding: 0 6px;
    background-color: #FFFFFF;
    color: #0078D4;
    font-size: 12px;
    font-weight: bold;
}

/* 标签 */
QLabel {
    color: #374151;
    font-size: 12px;
}

/* 输入框与下拉选择框 */
QLineEdit, QComboBox, QPlainTextEdit, QTextBrowser {
    background-color: #FFFFFF;
    border: 1px solid #D1D5DB;
    border-radius: 5px;
    padding: 4px 8px;
    font-size: 12px;
    color: #111827;
    selection-background-color: #0078D4;
    selection-color: #FFFFFF;
}

QLineEdit:hover, QComboBox:hover, QPlainTextEdit:hover, QTextBrowser:hover {
    border-color: #9CA3AF;
}

QLineEdit:focus, QComboBox:focus, QPlainTextEdit:focus {
    border: 2px solid #0078D4;
    padding: 3px 7px;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 22px;
    border-left: none;
}

QComboBox::down-arrow {
    image: none;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 5px solid #6B7280;
    margin-right: 6px;
}

QComboBox QAbstractItemView {
    background-color: #FFFFFF;
    border: 1px solid #E5E7EB;
    border-radius: 6px;
    padding: 4px;
    selection-background-color: #0078D4;
    selection-color: #FFFFFF;
    outline: none;
}

/* 按钮通用风格 (Fluent Button) */
QPushButton {
    background-color: #FFFFFF;
    border: 1px solid #D1D5DB;
    border-radius: 5px;
    padding: 5px 12px;
    font-size: 12px;
    font-weight: 500;
    color: #1F2937;
    min-height: 22px;
}

QPushButton:hover {
    background-color: #F9FAFB;
    border-color: #9CA3AF;
}

QPushButton:pressed {
    background-color: #E5E7EB;
    border-color: #6B7280;
}

QPushButton:disabled {
    background-color: #F3F4F6;
    color: #9CA3AF;
    border-color: #E5E7EB;
}

/* 主操作按钮 (Primary Microsoft Blue) */
QPushButton#getData_Start_bt {
    background-color: #0078D4;
    border: 1px solid #006CBD;
    color: #FFFFFF;
    font-weight: bold;
    font-size: 13px;
    min-height: 28px;
}

QPushButton#getData_Start_bt:hover {
    background-color: #106EBE;
}

QPushButton#getData_Start_bt:pressed {
    background-color: #005A9E;
}

/* 启动电机 (Fluent Green) */
QPushButton#start_bt {
    background-color: #F0FDF4;
    border: 1px solid #86EFAC;
    color: #15803D;
    font-weight: bold;
}

QPushButton#start_bt:hover {
    background-color: #DCFCE7;
    border-color: #4ADE80;
}

QPushButton#start_bt:pressed {
    background-color: #BBF7D0;
}

/* 停止电机 (Fluent Red) */
QPushButton#stop_bt {
    background-color: #FEF2F2;
    border: 1px solid #FECACA;
    color: #B91C1C;
    font-weight: bold;
}

QPushButton#stop_bt:hover {
    background-color: #FEE2E2;
    border-color: #F87171;
}

QPushButton#stop_bt:pressed {
    background-color: #FCA5A5;
}

/* 刷新所有串口按钮 (Fluent Accent Outline) */
QPushButton#refreshPorts_bt {
    background-color: #FFFFFF;
    border: 1px solid #0078D4;
    color: #0078D4;
    font-weight: 600;
    font-size: 13px;
    border-radius: 4px;
    padding: 6px 12px;
}

QPushButton#refreshPorts_bt:hover {
    background-color: #EFF6FC;
    border-color: #005A9E;
    color: #005A9E;
}

QPushButton#refreshPorts_bt:pressed {
    background-color: #DEECF9;
}

QPushButton#initFpgaSignal_bt {
    background-color: #0E7090;
    color: #FFFFFF;
    font-weight: 600;
    border: 1px solid #0891B2;
}

QPushButton#initFpgaSignal_bt:hover {
    background-color: #0891B2;
}

QPushButton#initFpgaSignal_bt:pressed {
    background-color: #155E75;
}

/* 电机相对控制特定样式 */
QPushButton#btnMoveBack {
    background-color: #ECFDF5;
    border: 1px solid #6EE7B7;
    color: #047857;
    font-weight: bold;
    font-size: 13px;
    border-radius: 5px;
}
QPushButton#btnMoveBack:hover {
    background-color: #D1FAE5;
    border-color: #34D399;
}
QPushButton#btnMoveBack:pressed {
    background-color: #A7F3D0;
}

QPushButton#btnMotorStop {
    background-color: #DC2626;
    border: 1px solid #B91C1C;
    color: #FFFFFF;
    font-weight: bold;
    font-size: 13px;
    border-radius: 5px;
}
QPushButton#btnMotorStop:hover {
    background-color: #B91C1C;
}
QPushButton#btnMotorStop:pressed {
    background-color: #991B1B;
}

QPushButton#btnMoveFront, QPushButton#btnMoveLeft, QPushButton#btnMoveRight {
    background-color: #F8FAFC;
    border: 1px solid #CBD5E1;
    color: #0F172A;
    font-weight: bold;
    font-size: 12px;
    border-radius: 5px;
}
QPushButton#btnMoveFront:hover, QPushButton#btnMoveLeft:hover, QPushButton#btnMoveRight:hover {
    background-color: #F1F5F9;
    border-color: #94A3B8;
}

QPushButton#btnSetRelZero {
    background-color: #EFF6FF;
    border: 1px solid #BFDBFE;
    color: #1D4ED8;
    font-weight: 600;
    border-radius: 4px;
    padding: 3px 6px;
}
QPushButton#btnSetRelZero:hover {
    background-color: #DBEAFE;
    border-color: #93C5FD;
}

QPushButton#btnGotoInitPos {
    background-color: #F5F3FF;
    border: 1px solid #DDD6FE;
    color: #6D28D9;
    font-weight: 600;
    border-radius: 4px;
    padding: 3px 6px;
}
QPushButton#btnGotoInitPos:hover {
    background-color: #EDE9FE;
    border-color: #C4B5FD;
}

QSpinBox, QDoubleSpinBox {
    background-color: #FFFFFF;
    border: 1px solid #D1D5DB;
    border-radius: 4px;
    padding: 3px 6px;
    font-size: 12px;
    color: #111827;
}
QSpinBox:focus, QDoubleSpinBox:focus {
    border: 2px solid #0078D4;
    padding: 2px 5px;
}

/* 选项卡 (Fluent Tabs) */
QTabWidget::pane {
    border: 1px solid #E5E7EB;
    border-radius: 6px;
    background-color: #FFFFFF;
    top: -1px;
}

QTabBar::tab {
    background-color: #F3F4F6;
    border: 1px solid #E5E7EB;
    border-bottom: none;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    padding: 6px 16px;
    margin-right: 3px;
    font-size: 12px;
    color: #4B5563;
}

QTabBar::tab:selected {
    background-color: #FFFFFF;
    border-bottom: 2px solid #0078D4;
    color: #0078D4;
    font-weight: 600;
}

QTabBar::tab:hover:!selected {
    background-color: #E5E7EB;
}

/* 滚动条 */
QScrollBar:vertical {
    border: none;
    background-color: #F9FAFB;
    width: 6px;
    border-radius: 3px;
}

QScrollBar::handle:vertical {
    background-color: #D1D5DB;
    min-height: 20px;
    border-radius: 3px;
}

QScrollBar::handle:vertical:hover {
    background-color: #9CA3AF;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

/* 高级串口设置折叠按钮 */
QPushButton#advancedSerial_bt {
    background-color: #F3F4F6;
    border: 1px solid #D1D5DB;
    color: #4B5563;
    font-size: 11px;
    border-radius: 4px;
    padding: 3px 8px;
}
QPushButton#advancedSerial_bt:hover {
    background-color: #E5E7EB;
    color: #111827;
}
QPushButton#advancedSerial_bt:checked {
    background-color: #E0F2FE;
    border-color: #0284C7;
    color: #0284C7;
    font-weight: 600;
}

/* 高级串口折叠面板 */
QFrame#frameAdvancedSerial {
    background-color: #F9FAFB;
    border: 1px dashed #CBD5E1;
    border-radius: 6px;
    padding: 4px;
}

/* 手动调试发送按钮 */
QPushButton#manualSendSignal_bt {
    background-color: #0284C7;
    border: 1px solid #0369A1;
    color: #FFFFFF;
    font-weight: 600;
    min-height: 26px;
}
QPushButton#manualSendSignal_bt:hover {
    background-color: #0369A1;
}

QPushButton#manualSendLoad_bt {
    background-color: #D97706;
    border: 1px solid #B45309;
    color: #FFFFFF;
    font-weight: 600;
    min-height: 26px;
}
QPushButton#manualSendLoad_bt:hover {
    background-color: #B45309;
}

/* 电机相对坐标卡片与数显 */
QFrame#cardRelX {
    background-color: #F0F9FF;
    border: 1px solid #BAE6FD;
    border-radius: 8px;
}
QFrame#cardRelY {
    background-color: #F0FDF4;
    border: 1px solid #BBF7D0;
    border-radius: 8px;
}
QFrame#cardRelZ {
    background-color: #F5F3FF;
    border: 1px solid #DDD6FE;
    border-radius: 8px;
}
QLabel#lblRelX {
    font-size: 20px;
    font-weight: bold;
    color: #0284C7;
}
QLabel#lblRelY {
    font-size: 20px;
    font-weight: bold;
    color: #16A34A;
}
QLabel#lblRelZ {
    font-size: 20px;
    font-weight: bold;
    color: #7C3AED;
}

/* 主选项卡样式强化 */
QTabWidget#mainTabWidget > QTabBar::tab {
    font-size: 13px;
    font-weight: bold;
    padding: 8px 22px;
}

QPushButton#btnBackToAuto {
    background-color: #0078D4;
    border: 1px solid #006CBD;
    color: #FFFFFF;
    font-weight: bold;
    font-size: 12px;
    border-radius: 5px;
    padding: 5px 14px;
}
QPushButton#btnBackToAuto:hover {
    background-color: #106EBE;
}
QPushButton#btnBackToAuto:pressed {
    background-color: #005A9E;
}
</string>
